---
import { Image } from "astro:assets";

interface Props {
  book: {
    id: number;
    title: string;
    slug: string;
    pages: number;
    image: {
      url: string;
    };
    contributions: Array<{
      author: {
        name: string;
      };
    }>;
  };
  progressPages?: number
  rating?: number;
}

const { book, progressPages, rating } = Astro.props;
const authorName = book?.contributions?.[0]?.author?.name || "Unknown Author";
const totalPages = book?.pages || 0;
const isReading = typeof progressPages === "number";
const isRead = typeof rating === "number";

const progressPercent =
  isReading && totalPages > 0
    ? Math.min(Math.round((progressPages / totalPages) * 100), 100)
    : 0;
---

<a
  href={`https://hardcover.app/books/${book?.slug}`}
  target="_blank"
  rel="noopener noreferrer"
  class="flex items-center gap-4 border border-neutral-800 px-4 py-2 bg-neutral-900/50 hover:border-[#C0C0C0] transition-colors"
>
  {
    book?.image?.url && (
      <Image
        src={book.image.url}
        alt={`Cover for ${book.title}`}
        width={64}
        height={80}
        format="webp"
        quality={90}
      />
    )
  }
  <div class="flex-1 min-w-0">
    <h2 class="text-lg font-bold text-white truncate m-0" title={book?.title}>
      {book?.title}
    </h2>
    <p class="text-sm text-neutral-400 mb-2">
      {authorName}
    </p>

	{
	  isRead && (
		<div class="flex items-center gap-0.5 mb-1">
		  {Array.from({ length: 5 }).map((_, i) => {
			const fillPercent = Math.max(0, Math.min(100, (rating - i) * 100));
			return (
			  <span class="relative inline-block w-6 h-6">
				<svg
				  viewBox="0 0 20 20"
				  class="absolute inset-0 w-6 h-6 text-[#3A3A3A]"
				  fill="currentColor"
				>
				  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
				</svg>
				<span
				  class="absolute inset-0 overflow-hidden"
				  style={`width: ${fillPercent}%`}
				>
				  <svg
					viewBox="0 0 20 20"
					class="w-6 h-6 text-[#C0C0C0]"
					fill="currentColor"
				  >
					<path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
				  </svg>
				</span>
			  </span>
			);
		  })}
		</div>
	  )
	}

    {
      isReading && (
        <>
          <div class="flex items-center justify-between text-xs text-neutral-400 mb-1">
            <span>
              {progressPages} of {totalPages > 0 ? totalPages : "X"} pages
            </span>
            <span class="font-semibold text-[#C0C0C0]">{progressPercent}%</span>
		  </div>
		  { totalPages != 0 && (
				<div class="relative h-1.5 w-full overflow-hidden rounded-full bg-[#3A3A3A]">
				  <div
					class="h-full rounded-full bg-[#C0C0C0] transition-all duration-500 ease-out"
					style={`width: ${progressPercent}%`}
				  />
				</div>
			  )
		  }
        </>
      )
    }
  </div>
</a>
